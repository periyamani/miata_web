# miata-web configuration (copy to .env). Only VITE_* values reach the browser — never put secrets here.

# Origin of miata-api when it is served from a different origin than this site, e.g. https://api.miata.example
# Leave empty in development (the dev server proxies /api) and when /api is served by the same origin.
VITE_API_URL=

# Development / preview only: where `npm run dev` and `npm run preview` forward /api (default http://localhost:5000).
VITE_API_PROXY_TARGET=
